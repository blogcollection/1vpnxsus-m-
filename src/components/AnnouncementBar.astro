---
import { siteConfig } from '../config/site';
---

<aside id="announcement-bar" class="announcement-bar" role="region" aria-label="网站最新公告">
  <div class="announcement-container">
    <div class="announcement-content">
      <span class="announcement-icon" aria-hidden="true">⚡</span>
      <span class="announcement-text">{siteConfig.announcementText}</span>
      <a href="#pricing" class="announcement-link">立即开通 &rarr;</a>
    </div>
    <button id="close-announcement" class="announcement-close" aria-label="关闭公告">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
</aside>

<style>
  .announcement-bar {
    background-color: var(--c-dark-green);
    color: #ffffff;
    min-height: 60px;
    display: flex;
    align-items: center;
    border-bottom: 2px solid var(--c-dark);
    position: relative;
    z-index: 40;
    transition: max-height 0.3s ease, opacity 0.3s ease, padding 0.3s ease;
  }

  .announcement-bar.is-hidden {
    display: none;
  }

  .announcement-container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .announcement-content {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .announcement-icon {
    font-size: 1.1rem;
    color: var(--c-yellow);
  }

  .announcement-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background-color: var(--c-yellow);
    color: var(--c-dark);
    padding: 0.15rem 0.65rem;
    border-radius: 9999px;
    font-weight: 800;
    font-size: 0.8rem;
    border: 1.5px solid var(--c-dark);
    transition: transform 0.15s ease;
  }

  .announcement-link:hover {
    transform: scale(1.05);
  }

  .announcement-close {
    background: transparent;
    border: 2px solid rgba(255, 255, 255, 0.4);
    color: #ffffff;
    cursor: pointer;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .announcement-close:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: #ffffff;
  }

  @media (max-width: 640px) {
    .announcement-content {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  const banner = document.getElementById('announcement-bar');
  const closeBtn = document.getElementById('close-announcement');
  
  if (banner && closeBtn) {
    if (sessionStorage.getItem('xsus_announcement_closed') === 'true') {
      banner.classList.add('is-hidden');
    }
    
    closeBtn.addEventListener('click', () => {
      banner.classList.add('is-hidden');
      sessionStorage.setItem('xsus_announcement_closed', 'true');
    });
  }
</script>
