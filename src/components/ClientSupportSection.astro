---
import { clientItems } from '../data/clients';
---

<section id="clients" class="clients-section" aria-labelledby="clients-title">
  <div class="container-custom">
    <!-- Header -->
    <div class="section-header">
      <div class="section-badge">
        <span>📱 CLIENT COMPATIBILITY</span>
      </div>
      <h2 id="clients-title" class="section-title">全平台软件无缝适配</h2>
      <p class="section-desc">
        XSUS 采用国际通用标准订阅格式，<strong>可搭配常见代理客户端使用</strong>。无需绑定专有私有软件，自由随心选。
      </p>
    </div>

    <!-- Clients Grid -->
    <div class="clients-grid">
      {clientItems.map((client) => (
        <div class="client-card tp-card">
          <div class="client-card-top" style={`border-top: 6px solid ${client.color};`}>
            <div class="client-header-row">
              <span class="client-platform-badge">{client.platform}</span>
              <span class="client-type-tag" style={`background-color: ${client.color}; color: ${client.color === '#FFD629' ? '#17131F' : '#FFFFFF'};`}>
                {client.badge}
              </span>
            </div>

            <h3 class="client-name">{client.name}</h3>
            <p class="client-desc">{client.description}</p>
          </div>

          <div class="client-card-bottom">
            <div class="client-rec">
              <span class="rec-label">推荐用于：</span>
              <span class="rec-val">{client.recommendedFor}</span>
            </div>

            <div class="client-protocols">
              <span class="proto-label">兼容协议：</span>
              <div class="proto-tags">
                {client.protocols.map((proto) => (
                  <span class="proto-pill">{proto}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Client Notice -->
    <div class="client-disclaimer">
      <span class="notice-icon">ℹ️</span>
      <p>
        注：以上客户端均为第三方独立开源或官方应用，XSUS 仅提供兼容的通用订阅链接与配置指导，非上述软件开发方。
      </p>
    </div>
  </div>
</section>

<style>
  .clients-section {
    background-color: var(--c-cream);
    padding: 5.5rem 0;
    border-bottom: 4px solid var(--c-dark);
  }

  .section-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3.5rem;
  }

  .section-badge {
    display: inline-block;
    background-color: var(--c-bright-purple);
    color: #ffffff;
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    font-weight: 900;
    font-size: 0.85rem;
    border: 2px solid var(--c-dark);
    box-shadow: 3px 3px 0px var(--c-dark);
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: var(--c-dark);
    margin-bottom: 0.75rem;
  }

  .section-desc {
    font-size: 1.15rem;
    color: #554e60;
    font-weight: 500;
    line-height: 1.6;
  }

  .section-desc strong {
    color: var(--c-orange);
    font-weight: 800;
  }

  /* Grid */
  .clients-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .clients-grid > :nth-child(4) {
      grid-column: 1 / span 1;
      margin-left: auto;
      width: 100%;
    }
    .clients-grid > :nth-child(5) {
      grid-column: 2 / span 2;
      width: 100%;
    }
  }

  .client-card {
    background: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 3.5px solid var(--c-dark);
  }

  .client-card-top {
    padding: 1.75rem 1.5rem;
  }

  .client-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .client-platform-badge {
    font-size: 0.75rem;
    font-weight: 800;
    color: #666;
    background-color: var(--c-cream);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    border: 1px solid rgba(0, 0, 0, 0.15);
  }

  .client-type-tag {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    border: 1.5px solid var(--c-dark);
    box-shadow: 2px 2px 0px var(--c-dark);
  }

  .client-name {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 900;
    color: var(--c-dark);
    margin-bottom: 0.5rem;
  }

  .client-desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: #555;
  }

  .client-card-bottom {
    padding: 1.25rem 1.5rem;
    background-color: var(--c-cream);
    border-top: 2px dashed rgba(23, 19, 31, 0.2);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .client-rec {
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .rec-label {
    font-weight: 700;
    color: #444;
  }

  .rec-val {
    font-weight: 800;
    color: var(--c-dark);
  }

  .client-protocols {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .proto-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #777;
  }

  .proto-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .proto-pill {
    background: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(0, 0, 0, 0.2);
  }

  /* Disclaimer */
  .client-disclaimer {
    margin-top: 3.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(0, 0, 0, 0.04);
    padding: 1rem 1.5rem;
    border-radius: 12px;
    border: 1.5px solid rgba(0, 0, 0, 0.12);
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    font-size: 0.85rem;
    color: #666;
    line-height: 1.4;
  }

  .notice-icon {
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .clients-grid {
      grid-template-columns: 1fr;
    }
    .clients-grid > :nth-child(5) {
      grid-column: auto;
    }
  }
</style>
