---
import { pricingPlans } from '../data/pricing';
import { siteConfig } from '../config/site';
---

<section id="pricing" class="pricing-section" aria-labelledby="pricing-title">
  <!-- Section Header -->
  <div class="container-custom">
    <div class="section-header">
      <div class="section-badge">
        <span>🎟️ TICKET & PASSES</span>
      </div>
      <h2 id="pricing-title" class="section-title">选一个适合你的 XSUS 套餐</h2>
      <p class="section-desc">
        透明无套路计费，全套餐均享高可用亚太与欧美骨干节点。随时升级或按需续费。
      </p>
    </div>

    <!-- Pricing Grid -->
    <div class="pricing-grid">
      {pricingPlans.map((plan) => (
        <div class={`tp-card plan-card ${plan.isPopular ? 'popular-card' : ''}`}>
          {plan.isPopular && (
            <div class="popular-ribbon">
              <span>{plan.badge}</span>
            </div>
          )}

          <!-- Card Header -->
          <div class="plan-header" style={`background-color: ${plan.headerBg};`}>
            {!plan.isPopular && plan.badge && (
              <span class="plan-tag-pill">{plan.badge}</span>
            )}
            <h3 class="plan-name">{plan.name}</h3>
            <p class="plan-target">{plan.targetUser}</p>

            <div class="plan-price-wrap">
              <span class="plan-currency">{plan.price}</span>
              <span class="plan-period">{plan.period}</span>
              {plan.originalPrice && (
                <span class="plan-original-price">原价 {plan.originalPrice}</span>
              )}
            </div>
          </div>

          <!-- Specs Highlights -->
          <div class="plan-specs">
            <div class="spec-row">
              <span class="spec-icon">📦</span>
              <span class="spec-label">高速流量：</span>
              <span class="spec-val">{plan.traffic}</span>
            </div>
            <div class="spec-row">
              <span class="spec-icon">📱</span>
              <span class="spec-label">设备限制：</span>
              <span class="spec-val">{plan.devices}</span>
            </div>
            <div class="spec-row">
              <span class="spec-icon">⚡</span>
              <span class="spec-label">节点速率：</span>
              <span class="spec-val">{plan.speed}</span>
            </div>
          </div>

          <!-- Feature List -->
          <ul class="plan-features" aria-label={`${plan.name}包含权益`}>
            {plan.features.map((feat) => (
              <li class="feature-item">
                <svg class="check-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{feat}</span>
              </li>
            ))}
          </ul>

          <!-- CTA Button -->
          <div class="plan-cta-wrap">
            <a
              href={siteConfig.registerUrl}
              class={`tp-btn w-full ${plan.isPopular ? 'tp-btn-orange' : 'tp-btn-purple'}`}
            >
              <span>{plan.ctaText}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Assurance Notes -->
    <div class="pricing-guarantee">
      <div class="guarantee-item">
        <span class="g-icon">🛡️</span>
        <div>
          <strong>多端通用订阅</strong>
          <p>支持 Clash、Shadowrocket、V2Ray 等主流客户端</p>
        </div>
      </div>
      <div class="guarantee-item">
        <span class="g-icon">⚡</span>
        <div>
          <strong>即时开通</strong>
          <p>完成选购后系统全自动下发订阅，无需人工审核</p>
        </div>
      </div>
      <div class="guarantee-item">
        <span class="g-icon">💬</span>
        <div>
          <strong>售后保障</strong>
          <p>Telegram 频道与工单系统实时在线答疑支持</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    background-color: var(--c-yellow);
    padding: 5rem 0;
    border-bottom: 4px solid var(--c-dark);
    position: relative;
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3.5rem;
  }

  .section-badge {
    display: inline-block;
    background-color: var(--c-deep-purple);
    color: var(--c-yellow);
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    font-weight: 900;
    font-size: 0.85rem;
    border: 2px solid var(--c-dark);
    box-shadow: 3px 3px 0px var(--c-dark);
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: var(--c-dark);
    margin-bottom: 0.75rem;
    text-shadow: 2px 2px 0px rgba(255, 255, 255, 0.8);
  }

  .section-desc {
    font-size: 1.15rem;
    color: #3b3020;
    font-weight: 600;
    line-height: 1.6;
  }

  /* Pricing Grid */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    align-items: stretch;
  }

  .plan-card {
    display: flex;
    flex-direction: column;
    position: relative;
    background: #ffffff;
    border: 3.5px solid var(--c-dark);
  }

  .popular-card {
    border-color: var(--c-orange);
    border-width: 4px;
    transform: translateY(-8px);
    box-shadow: 8px 8px 0px var(--c-dark);
  }

  .popular-card:hover {
    transform: translateY(-12px);
    box-shadow: 10px 10px 0px var(--c-dark);
  }

  .popular-ribbon {
    background-color: var(--c-orange);
    color: #ffffff;
    font-weight: 900;
    font-size: 0.85rem;
    text-align: center;
    padding: 0.4rem;
    border-bottom: 2px solid var(--c-dark);
    letter-spacing: 0.5px;
  }

  /* Plan Header */
  .plan-header {
    padding: 1.75rem 1.5rem;
    color: #ffffff;
    border-bottom: 3px solid var(--c-dark);
    position: relative;
  }

  .plan-tag-pill {
    display: inline-block;
    background: rgba(0, 0, 0, 0.35);
    color: var(--c-yellow);
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    margin-bottom: 0.5rem;
  }

  .plan-name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 900;
    margin-bottom: 0.25rem;
    color: #ffffff;
    text-shadow: 2px 2px 0px var(--c-dark);
  }

  .plan-target {
    font-size: 0.85rem;
    opacity: 0.92;
    min-height: 2.4em;
    line-height: 1.4;
    margin-bottom: 0.75rem;
  }

  .plan-price-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .plan-currency {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 900;
    color: var(--c-yellow);
    text-shadow: 2px 2px 0px var(--c-dark);
    line-height: 1;
  }

  .plan-period {
    font-size: 1rem;
    font-weight: 800;
    opacity: 0.9;
  }

  .plan-original-price {
    font-size: 0.85rem;
    text-decoration: line-through;
    opacity: 0.75;
    margin-left: auto;
  }

  /* Specs */
  .plan-specs {
    padding: 1.25rem 1.5rem;
    background-color: var(--c-cream);
    border-bottom: 2px dashed rgba(23, 19, 31, 0.25);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .spec-row {
    display: flex;
    align-items: center;
    font-size: 0.95rem;
  }

  .spec-icon {
    margin-right: 0.4rem;
    font-size: 1.05rem;
  }

  .spec-label {
    font-weight: 600;
    color: #555;
  }

  .spec-val {
    font-weight: 800;
    color: var(--c-dark);
    margin-left: auto;
  }

  /* Features */
  .plan-features {
    padding: 1.5rem;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex-grow: 1;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.95rem;
    line-height: 1.45;
    font-weight: 600;
    color: var(--c-dark);
  }

  .check-icon {
    color: var(--c-grass-green);
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* Plan CTA */
  .plan-cta-wrap {
    padding: 1.25rem 1.5rem 1.75rem;
  }

  .w-full {
    width: 100%;
  }

  /* Guarantee Section */
  .pricing-guarantee {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 3.5rem;
    background: #ffffff;
    border: 3px solid var(--c-dark);
    border-radius: 16px;
    padding: 1.5rem 2rem;
    box-shadow: 4px 4px 0px var(--c-dark);
  }

  .guarantee-item {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .g-icon {
    font-size: 2rem;
    background-color: var(--c-cream);
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    border: 2px solid var(--c-dark);
    flex-shrink: 0;
  }

  .guarantee-item strong {
    display: block;
    font-size: 1rem;
    font-weight: 800;
    color: var(--c-dark);
    margin-bottom: 2px;
  }

  .guarantee-item p {
    font-size: 0.85rem;
    color: #666;
    margin: 0;
    line-height: 1.4;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      max-width: 500px;
      margin-left: auto;
      margin-right: auto;
    }

    .popular-card {
      transform: none;
    }

    .pricing-guarantee {
      grid-template-columns: 1fr;
    }
  }
</style>
